# ScreenQA API keys - TEMPLATE ONLY. Never put a real key in this file.
#
# The REAL file lives at %APPDATA%\ScreenQA\.env (outside the project folder).
# Easiest way to create it - run this and paste your key when asked:
#     python -m screenqa.api_keys

# Which service ScreenQA uses: groq, gemini or anthropic
# (the helper above sets this to the service whose key you saved last)
SCREENQA_PROVIDER=groq

# Free: https://console.groq.com/keys
GROQ_API_KEY=

# Free, but many NEW Google accounts get "AQ." keys that Google currently rejects:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Paid (optional): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
